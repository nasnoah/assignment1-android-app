<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="16dp"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/ll_fa_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_alignParentTop="true">

        <ImageView
            android:id="@+id/iv_logo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/logo"
            android:layout_gravity="center"
            android:layout_marginTop="2dp"
            android:padding="4dp"
            android:contentDescription="@string/iv_logo"
            android:scaleType="fitXY"/>

        <TextView
            android:id="@+id/tv_fa_title_1"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:layout_marginStart="4dp"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/turquoise"
            android:text="@string/tv_fa_title_1" />

        <TextView
            android:id="@+id/tv_fa_title_2"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/yellow"
            android:text="@string/tv_fa_title_2" />

    </LinearLayout>

    <TextView
        android:id="@+id/tv_first_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/ll_fa_title"
        android:layout_marginTop="16dp"
        android:text="@string/tv_first_name" />

    <EditText
        android:id="@+id/et_first_name"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_below="@id/tv_first_name"
        android:textSize="16sp"
        android:hint="@string/et_first_name"
        android:inputType="textPersonName"
        android:maxLines="1"/>

    <TextView
        android:id="@+id/tv_last_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/et_first_name"
        android:layout_marginTop="16dp"
        android:text="@string/tv_last_name" />

    <EditText
        android:id="@+id/et_last_name"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_below="@+id/tv_last_name"
        android:textSize="16sp"
        android:hint="@string/et_last_name"
        android:inputType="textPersonName"
        android:maxLines="1"/>

    <TextView
        android:id="@+id/tv_yob"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/et_last_name"
        android:layout_marginTop="16dp"
        android:text="@string/tv_yob" />

    <EditText
        android:id="@+id/et_yob"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_below="@+id/tv_yob"
        android:textSize="16sp"
        android:hint="@string/et_yob"
        android:inputType="number"
        android:maxLines="1"/>

    <TextView
        android:id="@+id/tv_hometown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/et_yob"
        android:layout_marginTop="16dp"
        android:text="@string/tv_hometown" />

    <EditText
        android:id="@+id/et_hometown"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_below="@+id/tv_hometown"
        android:textSize="16sp"
        android:hint="@string/et_hometown"
        android:inputType="textPersonName"
        android:maxLines="1"/>

    <TextView
        android:id="@+id/tv_gender"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/et_hometown"
        android:layout_marginTop="16dp"
        android:text="@string/tv_gender"/>

    <RadioGroup
        android:id="@+id/rg_gender"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tv_gender"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rb_male"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:buttonTint="@color/turquoise"
            android:textSize="16sp"
            android:text="@string/rb_male"
            android:checked="true" />

        <RadioButton
            android:id="@+id/rb_female"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:buttonTint="@color/turquoise"
            android:textSize="16sp"
            android:text="@string/rb_female" />

    </RadioGroup>

    <TextView
        android:id="@+id/tv_good_manners"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/rg_gender"
        android:layout_marginTop="16dp"
        android:text="@string/tv_good_manners" />

    <CheckBox
        android:id="@+id/cb_respect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tv_good_manners"
        app:buttonTint="@color/turquoise"
        android:textSize="16sp"
        android:text="@string/cb_respect" />

    <CheckBox
        android:id="@+id/cb_help"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/cb_respect"
        app:buttonTint="@color/turquoise"
        android:textSize="16sp"
        android:text="@string/cb_help" />

    <CheckBox
        android:id="@+id/cb_honest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/cb_help"
        app:buttonTint="@color/turquoise"
        android:textSize="16sp"
        android:text="@string/cb_honest" />

    <LinearLayout
        android:id="@+id/ll_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:layout_marginTop="16dp">

        <Button
            android:id="@+id/btn_reset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="16sp"
            android:layout_marginEnd="10dp"
            app:cornerRadius="6dp"
            android:backgroundTint="@color/yellow"
            android:text="@string/btn_reset" />

        <Button
            android:id="@+id/btn_submit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="16sp"
            app:cornerRadius="6dp"
            android:backgroundTint="@color/turquoise"
            android:text="@string/btn_submit" />

    </LinearLayout>

</RelativeLayout>